{
  "name": "@johnhenry/browsermesh-primitives",
  "version": "0.1.0",
  "description": "Shared primitives for browser mesh networking — wire format, identity (Ed25519), CRDTs, capabilities, trust model, and ACL engine",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "mesh",
    "p2p",
    "crdt",
    "wire-format",
    "identity",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh",
    "directory": "packages/browsermesh-primitives"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/",
  "scripts": {
    "pretest": "npm run typecheck",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
