    "directory": "packages/browsermesh-transport"
  },
  "peerDependencies": {
    "@johnhenry/browsermesh-primitives": ">=0.6.0 <1.0.0",
    "@johnhenry/wsh": ">=0.45.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/wsh": {
      "optional": true
    }
  },
  "devDependencies": {
