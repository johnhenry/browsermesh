{
  "name": "@johnhenry/browsermesh-transport",
  "version": "0.12.1",
  "description": "WebSocket, WebRTC, WebTransport, relay, and sealed wsh peer-link adapters for BrowserMesh",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "node": "./src/index-node-compat.mjs",
      "default": "./src/index.mjs"
    },
    "./wsh": "./src/wsh.mjs",
    "./wsh-in-process": {
      "node": "./src/wsh-in-process.mjs"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh",
    "directory": "packages/browsermesh-transport"
  },
  "peerDependencies": {
    "@johnhenry/browsermesh-primitives": ">=0.6.0 <1.0.0",
    "@johnhenry/wsh": "*"
  },
  "peerDependenciesMeta": {
    "@johnhenry/wsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/browsermesh-pod": "^0.6.0",
    "@johnhenry/wsh": "^0.56.1",
    "node-datachannel": "^0.33.4"
  },
  "scripts": {
    "test": "node --import ./test/_setup-globals.mjs --test test/*.test.mjs",
    "test:real-peer": "node --import ./test/_setup-globals.mjs --test --test-concurrency=1 test/real-peer/*.test.mjs"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/",
  "engines": {
    "node": ">=26.0.0"
  }
}
