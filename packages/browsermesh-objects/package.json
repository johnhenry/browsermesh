{
  "name": "@johnhenry/browsermesh-objects",
  "version": "0.1.1",
  "description": "wsh's remote-object layer (values, events, handles, callbacks) over a BrowserMesh protocol channel, authorised per root and per action for the channel's verified peer",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:real-peer": "node --test --test-concurrency=1 test/real-peer/*.test.mjs"
  },
  "keywords": [
    "wsh",
    "remote-objects",
    "capabilities",
    "mesh",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh",
    "directory": "packages/browsermesh-objects"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/",
  "engines": {
    "node": ">=26.0.0"
  },
  "peerDependencies": {
    "@johnhenry/browsermesh-apps": ">=0.21.0 <1.0.0",
    "@johnhenry/wsh": ">=0.49.0 <1.0.0"
  },
  "devDependencies": {
    "@johnhenry/browsermesh-apps": "^0.21.1",
    "@johnhenry/browsermesh-core": "^0.13.0",
    "@johnhenry/browsermesh-primitives": "^0.6.1",
    "@johnhenry/browsermesh-transport": "^0.10.0",
    "@johnhenry/wsh": "^0.50.0",
    "node-datachannel": "^0.33.4"
  }
}
