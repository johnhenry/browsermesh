{
  "name": "@johnhenry/browsermesh-apps",
  "version": "0.1.1",
  "description": "Application layer: marketplace, chat, payments, compute, orchestration, and agent tools for BrowserMesh",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./compat": "./src/compat.mjs"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh",
    "directory": "packages/browsermesh-apps"
  },
  "peerDependencies": {
    "@johnhenry/browsermesh-primitives": ">=0.0.1 <1.0.0",
    "@johnhenry/browsermesh-core": ">=0.1.0 <1.0.0",
    "@johnhenry/browsermesh-transport": ">=0.1.0 <1.0.0",
    "@johnhenry/browsermesh-sync": ">=0.0.0 <1.0.0",
    "@johnhenry/browsermesh-discovery": ">=0.0.1 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/browsermesh-transport": {
      "optional": true
    },
    "@johnhenry/browsermesh-core": {
      "optional": true
    },
    "@johnhenry/browsermesh-discovery": {
      "optional": true
    }
  },
  "devDependencies": {
    "node-datachannel": "^0.33.2"
  },
  "scripts": {
    "test": "node --import ./test/_setup-globals.mjs --test test/*.test.mjs",
    "test:real-peer": "node --import ./test/_setup-globals.mjs --test --test-concurrency=1 test/real-peer/*.test.mjs"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/",
  "engines": {
    "node": ">=24.0.0"
  }
}
