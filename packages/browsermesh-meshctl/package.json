{
  "name": "@johnhenry/browsermesh-meshctl",
  "version": "0.0.0",
  "description": "Command-line client for hosted pods: meshctl is itself a pod, joins the mesh (a sealed wsh link through a relay, or WebRTC through a signalling server) and spawns, lists, sends to, snapshots and drains pods on the hosts that allow it",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    }
  },
  "bin": {
    "meshctl": "./bin/meshctl.mjs"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "mesh",
    "p2p",
    "cli",
    "pod-host",
    "hosted-pods"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh",
    "directory": "packages/browsermesh-meshctl"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@johnhenry/browsermesh-primitives": ">=0.2.0 <1.0.0",
    "@johnhenry/browsermesh-pod": ">=0.1.0 <1.0.0",
    "@johnhenry/browsermesh-core": ">=0.5.0 <1.0.0",
    "@johnhenry/browsermesh-apps": ">=0.18.0 <1.0.0",
    "@johnhenry/browsermesh-transport": ">=0.11.0 <1.0.0",
    "@johnhenry/wsh": ">=0.55.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/browsermesh-transport": {
      "optional": true
    },
    "@johnhenry/wsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/browsermesh-primitives": ">=0.0.1 <1.0.0",
    "@johnhenry/browsermesh-pod": ">=0.0.1 <1.0.0",
    "@johnhenry/browsermesh-core": ">=0.1.0 <1.0.0",
    "@johnhenry/browsermesh-apps": ">=0.18.0 <1.0.0",
    "@johnhenry/browsermesh-transport": ">=0.11.0 <1.0.0",
    "@johnhenry/wsh": "^0.55.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
