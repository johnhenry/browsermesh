{
  "name": "browsermesh-monorepo",
  "version": "0.0.4",
  "private": true,
  "description": "BrowserMesh Monorepo — peer-to-peer mesh networking primitives, transport, sync, and app runtime for browser environments",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "turbo run test --concurrency=4 && npm run test:docs",
    "test:docs": "node --test scripts/*.test.mjs",
    "test:real-peer": "npm run test:real-peer --workspace=@johnhenry/browsermesh-transport && npm run test:real-peer --workspace=@johnhenry/browsermesh-apps && npm run test:real-peer --workspace=@johnhenry/browsermesh-core && npm run test:real-peer --workspace=@johnhenry/browsermesh-pod && npm run test:real-peer --workspace=@johnhenry/browsermesh-objects && npm run test:real-peer --workspace=@johnhenry/browsermesh-mcp && npm run test:real-peer --workspace=@johnhenry/browsermesh-ingress && npm run test:real-peer --workspace=@johnhenry/browsermesh-egress",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "test:real-gpu": "npm run test:real-gpu --workspace=@johnhenry/browsermesh-apps",
    "test:real-firecracker": "npm run test:real-firecracker --prefix spikes/vm-pod-host",
    "test:real-linux-network": "npm run test:real-linux-network --prefix spikes/vm-pod-host",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:staggered": "./scripts/staggered-publish.sh",
    "release:staggered:dry-run": "./scripts/staggered-publish.sh --dry-run",
    "examples": "for f in examples/[0-9][0-9]-*.mjs packages/*/examples/*.mjs; do echo \"== $f\" && node \"$f\" || exit 1; done",
    "example:01": "node examples/01-identity-and-signed-messages.mjs",
    "example:02": "node examples/02-two-pods-discover-and-message.mjs",
    "example:03": "node examples/03-virtual-network-loopback.mjs",
    "example:04": "node examples/04-kernel-capability-denial.mjs",
    "example:05": "node examples/05-crdt-sync-across-two-engines.mjs",
    "example:06": "node examples/06-mesh-relay.mjs",
    "example:07": "node examples/07-full-mesh-pipeline.mjs",
    "example:08": "node examples/08-mesh-fetch-websocket.mjs",
    "example:09": "node examples/09-cloud-storage.mjs",
    "example:10": "node examples/10-mesh-kv-and-observability.mjs",
    "example:11": "node examples/11-agent-tool-calling.mjs",
    "example:12": "node examples/12-hosted-pod-over-websocket.mjs",
    "example:13": "node examples/13-pod-host-service.mjs",
    "example:14": "node examples/14-pod-host-over-mesh-fetch.mjs",
    "example:15": "node examples/15-agent-spawns-hosted-pod.mjs",
    "example:16": "node examples/16-supervised-hosted-pods.mjs",
    "example:17": "node examples/17-mesh-channel.mjs",
    "example:18": "node examples/18-wsh-sealed-peer-link.mjs",
    "example:19": "node examples/19-wsh-objects-over-protocol-channel.mjs",
    "example:20": "node examples/20-escrow-over-the-wire.mjs",
    "example:21": "node examples/21-http-ingress.mjs",
    "example:22": "node examples/22-mesh-egress.mjs",
    "example:egress-local-listener": "node packages/browsermesh-egress/examples/local-listener.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@johnhenry/wsh": "^0.59.0",
    "@playwright/test": "1.65.1",
    "esbuild": "^0.28.2",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "npm@10.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/",
  "allowScripts": {
    "webgpu@0.6.1": true
  }
}
