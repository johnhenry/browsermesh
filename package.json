{
  "name": "browsermesh-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "BrowserMesh Monorepo — peer-to-peer mesh networking primitives, transport, sync, and app runtime for browser environments",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "turbo run test --concurrency=4",
    "test:real-peer": "npm run test:real-peer --workspace=@johnhenry/browsermesh-transport",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:staggered": "./scripts/staggered-publish.sh",
    "release:staggered:dry-run": "./scripts/staggered-publish.sh --dry-run",
    "examples": "for f in examples/0*.mjs; do echo \"== $f\" && node \"$f\" || exit 1; done",
    "example:01": "node examples/01-identity-and-signed-messages.mjs",
    "example:02": "node examples/02-two-pods-discover-and-message.mjs",
    "example:03": "node examples/03-virtual-network-loopback.mjs",
    "example:04": "node examples/04-kernel-capability-denial.mjs",
    "example:05": "node examples/05-crdt-sync-across-two-engines.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/browsermesh"
  },
  "homepage": "https://opensource.johnhenry.me/browsermesh/"
}
